# Research LLM Provider API Keys
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
HF_TOKEN=your_huggingface_user_access_token_here
GROQ_API_KEY=your_groq_developer_api_key_here

# Single Source of Truth Model Names
GEMINI_MODEL=gemini-3.5-flash
GROQ_MODEL=llama-3.1-8b-instant
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
OLLAMA_MODEL=llama3.1:latest

# Local Ollama Host
OLLAMA_HOST=http://localhost:11434

# Model Enablement Flags
GOOGLE_GEMINI_35_FLASH_ENABLED=false
GOOGLE_GEMINI_35_FLASH_LITE_ENABLED=false
GROQ_LLAMA31_8B_INSTANT_ENABLED=false
HF_QWEN25_7B_INSTRUCT_ENABLED=false

OLLAMA_LLAMA31_8B_ENABLED=true
OLLAMA_QWEN3_8B_ENABLED=true
OLLAMA_MISTRAL_7B_ENABLED=true
OLLAMA_GEMMA3_4B_ENABLED=true
OLLAMA_PHI4_MINI_ENABLED=true

